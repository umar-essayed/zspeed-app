import 'package:z_speed/l10n/app_localizations.dart';
import 'package:flutter/material.dart';
import 'package:z_speed/components/receipt/receipt_header_card.dart';
import 'package:z_speed/components/receipt/receipt_items_card.dart';
import 'package:z_speed/components/receipt/receipt_price_summary.dart';
import 'package:z_speed/core/utils/receipt_generator.dart';

class ReceiptPage extends StatelessWidget {
  final String orderId;
  final String restaurantName;
  final List<Map<String, dynamic>> items;
  final double deliveryFee;

  const ReceiptPage({
    super.key,
    required this.orderId,
    required this.restaurantName,
    required this.items,
    this.deliveryFee = 15.0,
  });

  double get subtotal =>
      items.fold(0, (sum, item) => sum + (item['price'] * item['qty']));

  @override
  Widget build(BuildContext context) {
    final total = subtotal + deliveryFee;

    return Scaffold(
      appBar: AppBar(
        title: Text(AppLocalizations.of(context)!.orderReceipt,
            style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
        centerTitle: true,
        backgroundColor: Colors.orange.shade600,
        elevation: 2,
      ),
      body: SafeArea(
        child: Container(
          color: Colors.grey.shade50,
          child: SingleChildScrollView(
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  ReceiptHeaderCard(
                      orderId: orderId, restaurantName: restaurantName),
                  const SizedBox(height: 20),
                  ReceiptItemsCard(items: items),
                  const SizedBox(height: 20),
                  ReceiptPriceSummary(
                    subtotal: subtotal,
                    deliveryFee: deliveryFee,
                    total: total,
                  ),
                  const SizedBox(height: 20),
                  _buildActionButtons(context, total),
                  const SizedBox(height: 20),
                  Center(
                    child: Text(
                      "Keep this receipt for your records",
                      style: TextStyle(
                        fontSize: 14,
                        color: Colors.grey.shade600,
                        fontStyle: FontStyle.italic,
                      ),
                    ),
                  ),
                  const SizedBox(height: 20),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildActionButtons(BuildContext context, double total) {
    return Row(
      children: [
        Expanded(
          child: OutlinedButton(
            onPressed: () async {
              await ReceiptGenerator.generateAndShareReceipt(
                orderId: orderId,
                restaurantName: restaurantName,
                totalAmount: total,
                date: DateTime.now(),
              );
            },
            style: OutlinedButton.styleFrom(
              foregroundColor: Colors.orange.shade700,
              backgroundColor: Colors.white,
              side: BorderSide(color: Colors.orange.shade300, width: 2),
              padding: const EdgeInsets.symmetric(vertical: 16),
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(12)),
            ),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Icon(Icons.download),
                const SizedBox(width: 8),
                Flexible(
                  child: Text(AppLocalizations.of(context)!.downloadReceipt,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style:
                          const TextStyle(fontSize: 16, fontWeight: FontWeight.w600)),
                ),
              ],
            ),
          ),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: ElevatedButton(
            onPressed: () => Navigator.pop(context),
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.orange.shade600,
              foregroundColor: Colors.white,
              padding: const EdgeInsets.symmetric(vertical: 16),
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(12)),
              elevation: 2,
            ),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Icon(Icons.check_circle),
                const SizedBox(width: 8),
                Text(AppLocalizations.of(context)!.done,
                    style:
                        const TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
              ],
            ),
          ),
        ),
      ],
    );
  }
}

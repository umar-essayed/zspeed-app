import 'package:z_speed/l10n/app_localizations.dart';
import 'package:flutter/material.dart';
import 'package:z_speed/features/admin/model/admin_models.dart';
import 'package:z_speed/features/admin/model/admin_theme.dart';

/// Quick actions grid for the admin dashboard.
class AdminQuickActions extends StatelessWidget {
  const AdminQuickActions({
    super.key,
    required this.onAddUser,
    required this.onGenerateReport,
    required this.onNavigateToRestaurants,
    required this.onNavigateToSettings,
  });

  final VoidCallback onAddUser;
  final VoidCallback onGenerateReport;
  final VoidCallback onNavigateToRestaurants;
  final VoidCallback onNavigateToSettings;

  @override
  Widget build(BuildContext context) {
    final actions = [
      QuickActionData(
          title: 'Add New User',
          icon: Icons.person_add_alt_1_rounded,
          color: AdminTheme.primaryOrange),
      QuickActionData(
          title: 'Generate Report',
          icon: Icons.analytics_rounded,
          color: AdminTheme.infoBlue),
      QuickActionData(
          title: 'Manage Restaurants',
          icon: Icons.storefront_rounded,
          color: AdminTheme.warningAmber),
      QuickActionData(
          title: 'System Settings',
          icon: Icons.settings_rounded,
          color: AdminTheme.successGreen),
    ];

    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: AdminTheme.surfaceWhite,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: AdminTheme.borderColor, width: 1),
        boxShadow: [
          BoxShadow(
              color: Colors.black.withValues(alpha: 0.03),
              blurRadius: 15,
              offset: const Offset(0, 4),
              spreadRadius: -5),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(AppLocalizations.of(context)!.quickActions,
              style: TextStyle(
                  fontSize: 16,
                  fontWeight: FontWeight.w700,
                  color: AdminTheme.textDark)),
          const SizedBox(height: 16),
          Wrap(
              spacing: 12,
              runSpacing: 12,
              children: actions.map((a) => _buildAction(a, context)).toList()),
        ],
      ),
    );
  }

  String _localizeTitle(String title, BuildContext context) {
    final l = AppLocalizations.of(context)!;
    return switch (title) {
      'Add New User' => l.quickActionAddUser,
      'Generate Report' => l.quickActionGenerateReport,
      'Manage Restaurants' => l.quickActionManageRestaurants,
      'System Settings' => l.quickActionSystemSettings,
      _ => title,
    };
  }

  Widget _buildAction(QuickActionData action, BuildContext context) {
    return Container(
      width: 120,
      decoration: BoxDecoration(
        color: AdminTheme.white,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: AdminTheme.borderColor, width: 1),
        boxShadow: [
          BoxShadow(
              color: Colors.black.withValues(alpha: 0.03),
              blurRadius: 10,
              offset: const Offset(0, 2))
        ],
      ),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: () {
            switch (action.title) {
              case 'Add New User':
                onAddUser();
              case 'Generate Report':
                onGenerateReport();
              case 'Manage Restaurants':
                onNavigateToRestaurants();
              case 'System Settings':
                onNavigateToSettings();
            }
          },
          borderRadius: BorderRadius.circular(16),
          splashColor: action.color.withValues(alpha: 0.1),
          highlightColor: action.color.withValues(alpha: 0.05),
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Container(
                  width: 40,
                  height: 40,
                  decoration: BoxDecoration(
                    color: action.color.withValues(alpha: 0.1),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                        color: action.color.withValues(alpha: 0.2), width: 1),
                  ),
                  child: Center(
                      child: Icon(action.icon, color: action.color, size: 20)),
                ),
                const SizedBox(height: 8),
                Text(_localizeTitle(action.title, context),
                    textAlign: TextAlign.center,
                    maxLines: 2,
                    style: TextStyle(
                        fontSize: 11,
                        fontWeight: FontWeight.w600,
                        color: AdminTheme.textDark)),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

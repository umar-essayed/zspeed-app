/// Simple food item model for the home page grid display.
class FoodItem {
  final String name;
  final String image;
  final double rating;
  final String price;
  final String? restaurant;
  final String description;
  final String? nameAr;
  final String? descriptionAr;

  FoodItem({
    required this.name,
    required this.image,
    required this.rating,
    required this.price,
    this.restaurant,
    this.description = '',
    this.nameAr,
    this.descriptionAr,
  });

  String getLocalizedName(String langCode) =>
      (langCode == 'ar' && nameAr != null && nameAr!.isNotEmpty)
          ? nameAr!
          : name;

  String getLocalizedDescription(String langCode) =>
      (langCode == 'ar' && descriptionAr != null && descriptionAr!.isNotEmpty)
          ? descriptionAr!
          : description;
}

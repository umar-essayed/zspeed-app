/// Simple category model for the home page category bar.
class Category {
  final String name;
  final String image;
  final bool isActive;

  Category({
    required this.name,
    required this.image,
    this.isActive = false,
  });

  Category copyWith({String? name, String? image, bool? isActive}) {
    return Category(
      name: name ?? this.name,
      image: image ?? this.image,
      isActive: isActive ?? this.isActive,
    );
  }
}

import 'package:flutter/material.dart';

class SpeedLogoWithText extends StatelessWidget {
  const SpeedLogoWithText({super.key});

  @override
  Widget build(BuildContext context) {
    return const Row(
      mainAxisSize: MainAxisSize.min,
      children: [
        Icon(Icons.speed, color: Colors.orange, size: 32),
        SizedBox(width: 8),
        Text(
          "Z Speed",
          style: TextStyle(
            fontSize: 24,
            fontWeight: FontWeight.bold,
            color: Colors.orange,
          ),
        ),
      ],
    );
  }
}

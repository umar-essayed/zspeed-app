import 'package:flutter/material.dart';
import 'package:z_speed/features/payment_settings/widgets/payment_settings_dialogs.dart';

/// A reusable tile widget for displaying a payment method with optional
/// "Default" badge and edit button.
class PaymentMethodTile extends StatelessWidget {
  final String name;
  final IconData icon;
  final String details;
  final bool isDefault;

  const PaymentMethodTile({
    super.key,
    required this.name,
    required this.icon,
    required this.details,
    this.isDefault = false,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      margin: const EdgeInsetsDirectional.only(bottom: 10),
      child: ListTile(
        leading: Icon(icon, color: const Color(0xFFF35535)),
        title: Text(name),
        subtitle: Text(details),
        trailing: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            if (isDefault)
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: Colors.green[50],
                  borderRadius: BorderRadius.circular(4),
                ),
                child: const Text(
                  'Default',
                  style: TextStyle(
                    color: Colors.green,
                    fontSize: 12,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            const SizedBox(width: 10),
            IconButton(
              icon: const Icon(Icons.edit, size: 18),
              color: Colors.blue,
              onPressed: () {
                PaymentSettingsDialogs.showEditPaymentMethod(
                    context, name, details);
              },
            ),
          ],
        ),
      ),
    );
  }
}

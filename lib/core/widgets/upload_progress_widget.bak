import 'package:flutter/material.dart';

import 'package:z_speed/core/utils/image_utils.dart';

// ── Data Model ───────────────────────────────────────────────────────────────

/// Tracks the upload state of a single file.
class UploadFileStatus {
  final String fileName;
  final int? fileSize;
  final double progress; // 0.0 → 1.0
  final bool isComplete;
  final bool hasError;
  final String? errorMessage;
  final String? resultUrl;

  UploadFileStatus({
    required this.fileName,
    this.fileSize,
    this.progress = 0.0,
    this.isComplete = false,
    this.hasError = false,
    this.errorMessage,
    this.resultUrl,
  });

  UploadFileStatus copyWith({
    String? fileName,
    int? fileSize,
    double? progress,
    bool? isComplete,
    bool? hasError,
    String? errorMessage,
    String? resultUrl,
  }) {
    return UploadFileStatus(
      fileName: fileName ?? this.fileName,
      fileSize: fileSize ?? this.fileSize,
      progress: progress ?? this.progress,
      isComplete: isComplete ?? this.isComplete,
      hasError: hasError ?? this.hasError,
      errorMessage: errorMessage ?? this.errorMessage,
      resultUrl: resultUrl ?? this.resultUrl,
    );
  }

  int get percent => (progress * 100).round();
}

// ── Single File Upload Widget ────────────────────────────────────────────────

/// Shows a progress bar for a single file upload.
class UploadProgressWidget extends StatelessWidget {
  final UploadFileStatus status;

  const UploadProgressWidget({super.key, required this.status});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Container(
      margin: const EdgeInsets.symmetric(vertical: 4),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: _backgroundColor,
        borderRadius: BorderRadius.circular(10),
        border: Border.all(color: _borderColor, width: 1),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // File name + size
          Row(
            children: [
              Icon(_icon, size: 18, color: _iconColor),
              const SizedBox(width: 8),
              Expanded(
                child: Text(
                  status.fileName,
                  style: theme.textTheme.bodyMedium?.copyWith(
                    fontWeight: FontWeight.w500,
                  ),
                  overflow: TextOverflow.ellipsis,
                ),
              ),
              if (status.fileSize != null)
                Text(
                  ImageUtils.humanReadableSize(status.fileSize!),
                  style: theme.textTheme.bodySmall?.copyWith(
                    color: Colors.grey[600],
                  ),
                ),
            ],
          ),

          const SizedBox(height: 8),

          // Progress bar
          ClipRRect(
            borderRadius: BorderRadius.circular(6),
            child: LinearProgressIndicator(
              value: status.isComplete ? 1.0 : status.progress,
              minHeight: 6,
              backgroundColor: Colors.grey[200],
              valueColor: AlwaysStoppedAnimation<Color>(_progressColor),
            ),
          ),

          const SizedBox(height: 4),

          // Status text
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                _statusText,
                style: theme.textTheme.bodySmall?.copyWith(
                  color: _statusTextColor,
                ),
              ),
              if (!status.isComplete && !status.hasError)
                Text(
                  '${status.percent}%',
                  style: theme.textTheme.bodySmall?.copyWith(
                    fontWeight: FontWeight.w600,
                    color: Colors.blue[700],
                  ),
                ),
            ],
          ),

          // Error message
          if (status.hasError && status.errorMessage != null) ...[
            const SizedBox(height: 4),
            Text(
              status.errorMessage!,
              style: theme.textTheme.bodySmall?.copyWith(
                color: Colors.red[700],
              ),
            ),
          ],
        ],
      ),
    );
  }

  Color get _backgroundColor {
    if (status.hasError) return Colors.red.shade50;
    if (status.isComplete) return Colors.green.shade50;
    return Colors.blue.shade50;
  }

  Color get _borderColor {
    if (status.hasError) return Colors.red.shade200;
    if (status.isComplete) return Colors.green.shade200;
    return Colors.blue.shade200;
  }

  Color get _progressColor {
    if (status.hasError) return Colors.red;
    if (status.isComplete) return Colors.green;
    return Colors.blue;
  }

  IconData get _icon {
    if (status.hasError) return Icons.error_outline;
    if (status.isComplete) return Icons.check_circle_outline;
    return Icons.cloud_upload_outlined;
  }

  Color get _iconColor {
    if (status.hasError) return Colors.red;
    if (status.isComplete) return Colors.green;
    return Colors.blue;
  }

  String get _statusText {
    if (status.hasError) return 'Upload failed';
    if (status.isComplete) return 'Upload complete';
    if (status.progress == 0.0) return 'Waiting...';
    return 'Uploading...';
  }

  Color get _statusTextColor {
    if (status.hasError) return Colors.red.shade700;
    if (status.isComplete) return Colors.green.shade700;
    return Colors.blue.shade700;
  }
}

// ── Multi-File Upload Widget ─────────────────────────────────────────────────

/// Shows a stacked list of [UploadProgressWidget]s for multiple file uploads.
class MultiUploadProgressWidget extends StatelessWidget {
  final List<UploadFileStatus> statuses;
  final String? title;

  const MultiUploadProgressWidget({
    super.key,
    required this.statuses,
    this.title,
  });

  @override
  Widget build(BuildContext context) {
    if (statuses.isEmpty) return const SizedBox.shrink();

    final completed = statuses.where((s) => s.isComplete).length;
    final failed = statuses.where((s) => s.hasError).length;
    final total = statuses.length;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        if (title != null) ...[
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                title!,
                style: Theme.of(context).textTheme.titleSmall?.copyWith(
                      fontWeight: FontWeight.w600,
                    ),
              ),
              Text(
                '$completed/$total${failed > 0 ? ' ($failed failed)' : ''}',
                style: Theme.of(context).textTheme.bodySmall?.copyWith(
                      color: failed > 0 ? Colors.red : Colors.grey[600],
                    ),
              ),
            ],
          ),
          const SizedBox(height: 8),
        ],
        ...statuses.map((s) => UploadProgressWidget(status: s)),
      ],
    );
  }
}
